# ============================================
# Konfigurasi Email SIMAK
# Salin file ini menjadi ".env" lalu isi nilainya.
# File .env TIDAK ikut di-commit (lihat .gitignore).
# ============================================

# --- SMTP ---
SIMAK_EMAIL_HOST=smtp.gmail.com
SIMAK_EMAIL_PORT=587
# tls (port 587) atau ssl (port 465)
SIMAK_EMAIL_ENCRYPTION=tls
SIMAK_EMAIL_AUTH=true

# --- Kredensial akun pengirim ---
# Untuk Gmail: buat App Password (16 karakter) di
# https://myaccount.google.com/apppasswords
SIMAK_EMAIL_USERNAME=simak@nama_domain_email_instansi
SIMAK_EMAIL_PASSWORD=isi_app_password_16_karakter_disini

# --- Pengirim ---
# Kosongkan FROM_EMAIL untuk otomatis memakai USERNAME
#SIMAK_EMAIL_FROM_EMAIL=
SIMAK_EMAIL_FROM_NAME=SIMAK - Politeknik Mitra Industri

# --- Reply-To (opsional) ---
#SIMAK_EMAIL_REPLY_EMAIL=noreply@nama_domain_email_instansi
#SIMAK_EMAIL_REPLY_NAME=SIMAK No Reply

# --- Debug & log ---
# 0 = off, 2 = tampilkan log SMTP (development)
SIMAK_EMAIL_DEBUG=0
SIMAK_EMAIL_LOG=true

# ============================================
# Database
# ============================================
# Nilai di bawah adalah default XAMPP (development).
# Di production, selalu isi user & password khusus aplikasi.
SIMAK_DB_HOST=localhost
SIMAK_DB_NAME=simak_db
SIMAK_DB_USER=root
SIMAK_DB_PASS=
